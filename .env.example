# Onegodian.org environment template
# Copy to .env for local tooling only. Do not commit real secrets.

# Base site URL to audit or target in scripts
BASE_URL=https://onegodian.org

# Request timeout in seconds for audit tooling
TIMEOUT=20

# Future environment values
# STAGING_BASE_URL=https://staging.onegodian.org
# U_ONEGODIAN_BASE_URL=https://u.onegodian.org
# CHECKOUT_SUCCESS_BASE_URL=https://onegodian.org
# CHECKOUT_CANCEL_BASE_URL=https://onegodian.org
# PUBLIC_BASE_URL=https://onegodian.org
